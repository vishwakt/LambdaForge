# LambdaForge — Local development environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# In Lambda, all values come from SSM Parameter Store instead.
# See ARCHITECTURE.md for the full configuration hierarchy.

# ── Trading Mode ──────────────────────────────────────────────────────────────
# "paper" uses Alpaca paper trading (safe, no real money).
# "live"  uses Alpaca live trading (real money — use with caution).
TRADING_MODE=paper

# ── Alpaca API ────────────────────────────────────────────────────────────────
# Paper trading keys: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_PAPER=your_paper_api_key_here
ALPACA_SECRET_KEY_PAPER=your_paper_secret_key_here

# Live trading keys (only needed when TRADING_MODE=live):
# https://app.alpaca.markets/dashboard/overview
ALPACA_API_KEY_LIVE=your_live_api_key_here
ALPACA_SECRET_KEY_LIVE=your_live_secret_key_here

# Fallback: used if mode-specific keys above are not set
# ALPACA_API_KEY=your_api_key_here
# ALPACA_SECRET_KEY=your_secret_key_here

# ── Notifications ─────────────────────────────────────────────────────────────
# Email address for trade alerts and digest emails.
# Must be verified in AWS SES before emails will send.
NOTIFICATION_EMAIL=you@example.com

# Notifier backend: "console" (local dev), "sns", or "console+sns" (Lambda default).
NOTIFIER_TYPE=console

# How often to send trade activity emails: "realtime", "hourly" (default), or "daily".
NOTIFY_FREQUENCY=hourly

# SNS topic ARN — set automatically by SAM in Lambda; only needed locally if
# NOTIFIER_TYPE includes "sns".
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:stock-trading-bot-alerts

# ── AWS ───────────────────────────────────────────────────────────────────────
# Only needed if running Lambda functions locally via SAM.
# In Lambda, the execution role provides credentials automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# S3 bucket for trades.db persistence (set automatically by SAM in Lambda).
# TRADES_DB_BUCKET=stock-trader-db-YOUR_ACCOUNT_ID
# TRADES_DB_KEY=trades.db

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the local SQLite trades database.
# In Lambda this is /tmp/trades.db (synced to/from S3 each invocation).
# DB_PATH=trades.db

# ── SSM Parameter Store ───────────────────────────────────────────────────────
# Parameter prefix for this stack.
# /stock-bot/ for paper, /stock-bot-live/ for live, /stock-bot-2/ for Bot 2.
# SSM_PREFIX=/stock-bot/
#
# All supported SSM parameters (set via aws ssm put-parameter):
#   /stock-bot/trading_mode        (String)      — paper or live
#   /stock-bot/alpaca_api_key      (SecureString) — Alpaca key
#   /stock-bot/alpaca_secret_key   (SecureString) — Alpaca secret
#   /stock-bot/notification_email  (String)      — alert email
#   /stock-bot/max_positions       (String)      — default: 12
#   /stock-bot/trailing_stop_pct   (String)      — default: 0.05
#   /stock-bot/max_concentration   (String)      — default: 0.15
#   /stock-bot/max_daily_loss      (String)      — default: 0.02
#   /stock-bot/min_confidence      (String)      — default: 0.5
#   /stock-bot/monitor_interval    (String)      — default: 1 (minutes)
#   /stock-bot/notify_frequency    (String)      — default: hourly
#   /stock-bot/kill-switch         (String)      — alive or kill
