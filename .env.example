# Trading Mode: "paper" or "live"
TRADING_MODE=paper

# Paper Trading Credentials
# Get yours at: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_PAPER=your_paper_api_key_here
ALPACA_SECRET_KEY_PAPER=your_paper_secret_key_here

# Live Trading Credentials (only needed when TRADING_MODE=live)
# Get yours at: https://app.alpaca.markets/dashboard/overview
ALPACA_API_KEY_LIVE=your_live_api_key_here
ALPACA_SECRET_KEY_LIVE=your_live_secret_key_here

# Fallback: if mode-specific keys aren't set, these are used
# ALPACA_API_KEY=your_api_key_here
# ALPACA_SECRET_KEY=your_secret_key_here

# AWS (only needed for Lambda deployment)
# TRADES_DB_BUCKET=your-s3-bucket-name
# TRADES_DB_KEY=trades.db

# Notifications
# NOTIFIER_TYPE: "console" (default), "sns", or "console+sns"
NOTIFIER_TYPE=console
# SNS_TOPIC_ARN: set automatically in Lambda via template.yaml
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:042697403670:stock-trading-bot-TradingAlertsTopic-XXXXX

# AWS SSM Parameter Store (M6)
# In Lambda, all config is read from SSM /stock-bot/* at runtime.
# For local dev, use env vars above. SSM params are:
#   /stock-bot/trading_mode        (String)
#   /stock-bot/alpaca_api_key      (SecureString)
#   /stock-bot/alpaca_secret_key   (SecureString)
#   /stock-bot/notification_email  (String)
#   /stock-bot/max_positions       (String, default: 12)
#   /stock-bot/trailing_stop_pct   (String, default: 0.05)
#   /stock-bot/max_concentration   (String, default: 0.15)
#   /stock-bot/max_daily_loss      (String, default: 0.02)
#   /stock-bot/min_confidence      (String, default: 0.5)
